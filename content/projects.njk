		{{ websiteCarousel([
			{ url: "https://web.archive.org/web/20260723061613if_/https://www.goscouting.org/", alt: "The Go Scouting homepage, with a mountain-and-forest banner reading \"Preparing Kids For Real Life\" beside a ZIP code search bar to find local programs." }
